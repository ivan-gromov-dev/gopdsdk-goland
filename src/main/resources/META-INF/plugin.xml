<idea-plugin>
    <id>dev.gopdsdk</id>
    <name>gopdsdk</name>
    <vendor>gopdsdk</vendor>
    <description><![CDATA[
        Playdate-specific diagnostics, rule help, and safe fixes provided by
        the gopdsdk language server alongside GoLand's normal Go support.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.goland</depends>
    <depends>org.jetbrains.plugins.go</depends>
    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.integrationProvider implementation="dev.gopdsdk.goland.GopdsdkLspIntegrationProvider"/>
        <projectConfigurable parentId="tools" instance="dev.gopdsdk.goland.GopdsdkConfigurable" id="dev.gopdsdk.settings" displayName="gopdsdk"/>
        <notificationGroup id="gopdsdk" displayType="BALLOON"/>
        <configurationType implementation="dev.gopdsdk.goland.SimulatorConfigurationType"/>
        <statusBarWidgetFactory id="gopdsdk.simulator.target" implementation="dev.gopdsdk.goland.SimulatorStatusBarWidgetFactory"/>
        <toolWindow id="Playdate" anchor="bottom" factoryClass="dev.gopdsdk.goland.PlaydateToolWindowFactory"/>
        <externalAnnotator language="go" implementationClass="dev.gopdsdk.goland.BuildFailureAnnotator"/>
    </extensions>
    <actions>
        <group id="gopdsdk.actions" text="gopdsdk" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="gopdsdk.refreshDiagnostics" class="dev.gopdsdk.goland.GopdsdkRefreshAction" text="Refresh Diagnostics"/>
            <action id="gopdsdk.restartServer" class="dev.gopdsdk.goland.GopdsdkRestartAction" text="Restart Language Server"/>
            <action id="gopdsdk.showLogs" class="dev.gopdsdk.goland.GopdsdkShowLogsAction" text="Show Language Server Logs"/>
            <action id="gopdsdk.troubleshoot" class="dev.gopdsdk.goland.GopdsdkTroubleshootAction" text="Troubleshoot"/>
            <action id="gopdsdk.newGame" class="dev.gopdsdk.goland.NewPlaydateGameAction" text="New Playdate Game…"/>
            <action id="gopdsdk.analyzer" class="dev.gopdsdk.goland.AnalyzerAdministrationAction" text="Analyzer Configuration and Findings…"/>
            <separator/>
            <action id="gopdsdk.buildSimulator" class="dev.gopdsdk.goland.BuildSimulatorAction" text="Build for Simulator" icon="AllIcons.Actions.Compile"/>
            <action id="gopdsdk.runSimulator" class="dev.gopdsdk.goland.RunSimulatorAction" text="Build and Run in Simulator" icon="AllIcons.Actions.Execute"/>
            <separator/>
            <action id="gopdsdk.buildDevice" class="dev.gopdsdk.goland.BuildDeviceAction" text="Build for Device"/>
            <action id="gopdsdk.runDevice" class="dev.gopdsdk.goland.RunDeviceAction" text="Build, Install and Run on Device"/>
            <action id="gopdsdk.checkDeviceConnection" class="dev.gopdsdk.goland.CheckDeviceConnectionAction" text="Check Device Connection"/>
            <action id="gopdsdk.readCrashLog" class="dev.gopdsdk.goland.ReadCrashLogAction" text="Read Crash Log (Mounts Data Disk)"/>
            <action id="gopdsdk.readErrorLog" class="dev.gopdsdk.goland.ReadErrorLogAction" text="Read Error Log (Mounts Data Disk)"/>
            <action id="gopdsdk.mountDeviceDisk" class="dev.gopdsdk.goland.MountDeviceDiskAction" text="Mount Data Disk"/>
            <action id="gopdsdk.unmountDeviceDisk" class="dev.gopdsdk.goland.UnmountDeviceDiskAction" text="Safely Eject Data Disk and Reconnect USB"/>
        </group>
        <reference ref="gopdsdk.buildSimulator">
            <add-to-group group-id="RunMenu" anchor="last"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>
        </reference>
        <reference ref="gopdsdk.buildDevice">
            <add-to-group group-id="RunMenu" anchor="last"/>
        </reference>
        <reference ref="gopdsdk.runDevice">
            <add-to-group group-id="RunMenu" anchor="last"/>
        </reference>
        <reference ref="gopdsdk.runSimulator">
            <add-to-group group-id="RunMenu" anchor="last"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>
        </reference>
    </actions>
</idea-plugin>
